# ---------- Claude ----------
ANTHROPIC_API_KEY=sk-ant-...
# Reasoning effort for the chat loop: low | medium | high | xhigh | max
# WhatsApp is latency-sensitive; "low" keeps replies fast. Raise if answers feel shallow.
AGENT_EFFORT=low

# ---------- WhatsApp Cloud API ----------
# Meta App Dashboard -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Meta App Dashboard -> App Settings -> Basic -> App Secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string you choose; paste the same value into the Meta webhook config
WHATSAPP_VERIFY_TOKEN=change-me-to-a-random-string
WHATSAPP_GRAPH_VERSION=v23.0

# ---------- Staff ----------
# Who gets new-order alerts and can drive order status by texting the shop number.
# E.164 digits, no '+', comma separated. Leave empty and nobody is told about orders.
STAFF_NUMBERS=
# Approved WhatsApp template names, used only outside the 24h service window.
TEMPLATE_ORDER_ON_THE_WAY=
TEMPLATE_ORDER_DELIVERED=
TEMPLATE_LANGUAGE=en

# ---------- Store ----------
STORE_NAME=Your Grocery Store
STORE_HOURS=Mon-Sat 8:00am - 8:00pm, Sun 9:00am - 4:00pm
DELIVERY_FEE=500
FREE_DELIVERY_OVER=10000
MIN_ORDER_TOTAL=1000
DELIVERY_AREAS=Georgetown, East Bank Demerara, East Coast Demerara
CURRENCY_CODE=GYD
CURRENCY_SYMBOL=$
CURRENCY_DECIMALS=0

# ---------- Catalogue ----------
# Re-import the CSV on every boot and deactivate anything missing from it, so the
# committed file is the source of truth on a host with no shell. Leave false and
# the CSV only ever seeds an empty catalogue.
CATALOG_SYNC_ON_BOOT=false
# SKUs never imported. WhatsApp prohibits selling alcohol and tobacco.
RESTRICTED_SKUS=

# ---------- Server ----------
PORT=3000
DATABASE_PATH=./data/store.db
# Set to "false" in production to disable the browser test simulator
ENABLE_SIMULATOR=true
