{
  "name": "wa-grocery-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "import:catalog": "node --env-file-if-exists=.env src/catalog/import-csv.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --env-file-if-exists=.env src/smoke.ts",
    "check": "node --env-file-if-exists=.env src/check-config.ts",
    "settings:apply": "node --env-file-if-exists=.env src/apply-settings.ts",
    "eval": "node --env-file-if-exists=.env src/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
